{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "action.schema.json",
  "title": "action",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "action": {
          "const": "list_records"
        },
        "args": {
          "type": "object",
          "properties": {
            "table": {
              "enum": [
                "ledger",
                "invoices",
                "payments",
                "fx"
              ]
            },
            "cursor": {
              "type": [
                "string",
                "null"
              ]
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          },
          "required": [
            "table"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "action",
        "args"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "action": {
          "const": "get_record"
        },
        "args": {
          "type": "object",
          "properties": {
            "table": {
              "enum": [
                "ledger",
                "invoices",
                "payments",
                "fx"
              ]
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          },
          "required": [
            "table",
            "id"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "action",
        "args"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "action": {
          "const": "get_document"
        },
        "args": {
          "type": "object",
          "properties": {
            "doc_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          },
          "required": [
            "doc_id"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "action",
        "args"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "action": {
          "const": "calculator"
        },
        "args": {
          "type": "object",
          "properties": {
            "expression": {
              "type": "string",
              "maxLength": 256
            }
          },
          "required": [
            "expression"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "action",
        "args"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "action": {
          "const": "submit"
        },
        "args": {
          "type": "object",
          "properties": {
            "findings": {
              "$ref": "submission.schema.json"
            }
          },
          "required": [
            "findings"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "action",
        "args"
      ],
      "additionalProperties": false
    }
  ],
  "description": "One step action: {\"action\": name, \"args\": {...}}. Anything else costs a step and returns an error."
}
